{
  "id": "location_changed",
  "title": {
    "en": "Car enters or leaves an area",
    "no": "Bilen kjører inn i eller ut av et område",
    "sv": "Bilen kör in i eller ut ur ett område"
  },
  "titleFormatted": {
    "en": "Car [[comparison]] within [[radius]]m of coordinates ([[latitude]], [[longitude]])",
    "no": "Bilen [[comparison]] innenfor [[radius]]m av koordinater ([[latitude]], [[longitude]])",
    "sv": "Bilen [[comparison]] inom [[radius]] m från koordinaterna ([[latitude]], [[longitude]])"
  },
  "hint": {
    "en": "Triggered when the car moves into or out of the circle around the given coordinates",
    "no": "Utløses når bilen kjører inn i eller ut av sirkelen rundt de gitte koordinatene",
    "sv": "Utlöses när bilen kör in i eller ut ur cirkeln runt de angivna koordinaterna"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=cars"
    },
    {
      "name": "comparison",
      "type": "dropdown",
      "title": {
        "en": "Movement",
        "no": "Bevegelse",
        "sv": "Rörelse"
      },
      "values": [
        {
          "id": "enters",
          "title": {
            "en": "enters",
            "no": "kjører inn",
            "sv": "kör in"
          }
        },
        {
          "id": "exits",
          "title": {
            "en": "exits",
            "no": "kjører ut",
            "sv": "kör ut"
          }
        }
      ]
    },
    {
      "name": "latitude",
      "type": "number",
      "title": {
        "en": "Latitude",
        "no": "Breddegrad",
        "sv": "Latitud"
      },
      "min": -90,
      "max": 90,
      "step": 0.000001,
      "placeholder": {
        "en": "60.123456",
        "no": "60.123456"
      }
    },
    {
      "name": "longitude",
      "type": "number",
      "title": {
        "en": "Longitude",
        "no": "Lengdegrad",
        "sv": "Longitud"
      },
      "min": -180,
      "max": 180,
      "step": 0.000001,
      "placeholder": {
        "en": "10.123456",
        "no": "10.123456"
      }
    },
    {
      "name": "radius",
      "type": "number",
      "title": {
        "en": "Radius (meters)",
        "no": "Radius (meter)",
        "sv": "Radie (meter)"
      },
      "min": 10,
      "max": 1000,
      "step": 10,
      "default": 100
    }
  ],
  "tokens": [
    {
      "name": "distance",
      "type": "number",
      "title": {
        "en": "Distance moved (m)",
        "no": "Avstand kjørt (m)",
        "sv": "Körd sträcka (m)"
      },
      "example": 850
    }
  ]
}
