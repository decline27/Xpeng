{
  "id": "location_changed",
  "title": {
    "en": "Car location matches address",
    "no": "Bil posisjon matcher adresse"
  },
  "titleFormatted": {
    "en": "Car [[comparison]] within [[radius]]m of [[address]]",
    "no": "Bilen [[comparison]] innenfor [[radius]]m av [[address]]"
  },
  "hint": {
    "en": "Triggered when the car enters or exits the specified address area",
    "no": "Utløses når bilen kjører inn eller ut av det angitte adresseområdet"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=cars"
    },
    {
      "name": "comparison",
      "type": "dropdown",
      "title": {
        "en": "Movement",
        "no": "Bevegelse"
      },
      "values": [
        {
          "id": "enters",
          "title": {
            "en": "enters",
            "no": "kjører inn"
          }
        },
        {
          "id": "exits",
          "title": {
            "en": "exits",
            "no": "kjører ut"
          }
        }
      ]
    },
    {
      "name": "address",
      "type": "text",
      "title": {
        "en": "Address",
        "no": "Adresse"
      },
      "placeholder": {
        "en": "Enter address",
        "no": "Skriv inn adresse"
      }
    },
    {
      "name": "radius",
      "type": "number",
      "title": {
        "en": "Radius (meters)",
        "no": "Radius (meter)"
      },
      "min": 10,
      "max": 1000,
      "step": 10,
      "default": 100
    }
  ],
  "tokens": [
    {
      "name": "distance",
      "type": "number",
      "title": {
        "en": "Distance",
        "no": "Avstand"
      },
      "example": 50
    }
  ]
}
